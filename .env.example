# ─── Supabase (VITE_ prefix exposes to browser — only public keys) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Supabase (server-side only — NEVER expose to browser) ────────────────
# SUPABASE_URL is the same as VITE_SUPABASE_URL but used by serverless functions.
# Add BOTH to Vercel Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Boardroom API (server-side only) ─────────────────────────────────────
BOARDROOM_API_BASE_URL=
BOARDROOM_API_KEY=

# ─── Stripe (server-side only) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Shopify Partner API (server-side only) ───────────────────────────────
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_ACCESS_TOKEN=
SHOPIFY_APP_ID=

# Optional: Admin GraphQL Shop.email (client credentials). Partner API cannot return shop email.
# Use the Boardroom app Client ID / Secret from the Dev Dashboard. No extra Admin scope is
# required for `shop { email }`. Client credentials only work for shops in the same Shopify org.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── MailerLite (future — server-side only) ───────────────────────────────
MAILERLITE_API_KEY=

# ─── CRM Auth ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed email addresses or domains
# e.g. "admin@ecommboardroom.com,@ecommboardroom.com"
CRM_ALLOWED_EMAILS=

# ─── Optional: Boardroom Admin URL (for "Open User" links) ───────────────
VITE_BOARDROOM_ADMIN_URL=
